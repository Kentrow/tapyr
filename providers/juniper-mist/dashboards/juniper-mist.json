            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, last_over_time(mist_device_cpu_usage_ratio[15m]) * on (mac) group_left (name) max by (mac, name) (last_over_time(mist_device_info{site_id=~\"$site\"}[15m])))",
          "legendFormat": "{{name}}"
