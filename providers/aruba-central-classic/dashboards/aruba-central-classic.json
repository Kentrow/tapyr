    {
      "id": 9,
      "type": "timeseries",
      "title": "Clients by site",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (site) (last_over_time(aruba_ap_clients[15m]) * on (serial) group_left (site) max by (serial, site) (last_over_time(aruba_ap_info{site=~\"$site\"}[15m])))",
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Access points up by site",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (site) (last_over_time(aruba_ap_up[15m]) * on (serial) group_left (site) max by (serial, site) (last_over_time(aruba_ap_info{site=~\"$site\"}[15m])))",
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
