          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(rutos_failover_interface_online{router=~\"$router\"} == 0 and rutos_failover_interface_enabled{router=~\"$router\"} == 1) or vector(0)",
