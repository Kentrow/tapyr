            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(rms_device_mobile_rsrp_dbm[15m]) * on (device_id) group_left (name) max by (device_id, name) (last_over_time(rms_device_info{model=~\"$model\"}[15m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -100
              },
              {
                "color": "green",
                "value": -90
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Reference signal received power. Dashed lines: the categories of the Teltonika recommendations for 4G (orange: fair to poor, red: poor), https://wiki.teltonika-networks.com/view/Mobile_Signal_Strength_Recommendations"
    },
