    {
      "id": 17,
      "type": "row",
      "title": "Data usage (rms-device-data-usage job)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "bargauge",
      "title": "Received today",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (device_id) (last_over_time(rms_device_mobile_received_bytes_today[12h])) * on (device_id) group_left (name) max by (device_id, name) (last_over_time(rms_device_info[12h]))",
          "legendFormat": "{{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No report in the last 12 hours",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
