# Example configuration for __NAME__, against tapyr sim --provider-path
# <parent directory> --provider __NAME__ --listen 127.0.0.1:8081.
apiVersion: tapyr/v1alpha1
kind: Account
metadata: { name: lab }
spec:
  provider: __NAME__
  params: { baseURL: "http://127.0.0.1:8081/v1" }
  secrets:
    apiKey: { env: TAPYR_LAB_API_KEY }   # the simulator accepts sim-api-key
---
apiVersion: tapyr/v1alpha1
kind: Job
metadata: { name: devices }
spec: { account: lab, template: __NAME__-devices }
