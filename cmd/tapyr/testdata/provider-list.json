    {
      "name": "aruba-central-classic",
      "version": "0.1.0",
      "displayName": "HPE Aruba Networking Central (classic)",
      "description": "HPE Aruba Networking Central (classic platform) REST API",
      "docs": "https://developer.arubanetworks.com/aruba-central/",
      "categories": [
        "network",
        "wireless"
      ],
      "maintainers": [
        "Kentrow"
      ],
      "tier": "official",
      "validation": {
        "status": "real-platform",
        "date": "2026-11-10",
        "platformVersion": "Central classic API Gateway",
        "notes": "A production Central account, strictly read-only: every template, the refresh of the rotating token pair, a restart resuming from the stored pair, and the daily quota headers. Built from the Aruba developer hub and the pycentral SDK"
      },
      "origin": "builtin",
      "status": "active",
      "readme": "providers/aruba-central-classic/README.md",
      "simulator": true,
      "auth": "plugin:aruba_central_classic",
      "templates": [
        {
          "name": "aruba-aps",
          "path": "/monitoring/v2/aps",
          "defaultInterval": "5m",
          "metrics": [
            "aruba_ap_clients",
            "aruba_ap_info",
            "aruba_ap_up",
            "aruba_aps"
          ]
        },
        {
          "name": "aruba-gateways",
          "path": "/monitoring/v1/gateways",
          "defaultInterval": "15m",
          "metrics": [
            "aruba_gateway_info",
            "aruba_gateway_up"
          ]
        },
        {
          "name": "aruba-sites",
          "path": "/central/v2/sites",
          "defaultInterval": "1h",
          "metrics": [
            "aruba_site_info"
          ]
        },
        {
          "name": "aruba-switches",
          "path": "/monitoring/v1/switches",
          "defaultInterval": "15m",
          "metrics": [
            "aruba_switch_info",
            "aruba_switch_up"
          ]
        }
      ],
      "limits": [
        {
          "name": "daily",
          "kind": "quota",
          "value": "auto (5000 until learned) per day, reset at 00:00 UTC",
          "scope": [
            "account"
          ],
          "description": "Calls per account and day: the maximum of 5000 and 30 per Foundation device plus 90 per Advanced device, reset at midnight GMT, reported in X-RateLimit-*-day headers (developer.arubanetworks.com, Usage and Rate Limits)",
          "source": {
            "kind": "vendor-docs",
            "url": "https://developer.arubanetworks.com/hpe-aruba-networking-central/docs/usage-and-rate-limits",
            "date": "2026-11"
          }
        },
        {
          "name": "second",
          "kind": "rate",
          "value": "7/s, burst 7",
          "scope": [
            "account"
          ],
          "description": "7 calls per account per second (developer.arubanetworks.com, Usage and Rate Limits)",
          "source": {
            "kind": "vendor-docs",
            "url": "https://developer.arubanetworks.com/hpe-aruba-networking-central/docs/usage-and-rate-limits",
            "date": "2026-11"
          }
        }
      ]
    },
    {
      "name": "cisco-thousandeyes",
      "version": "0.1.0",
      "displayName": "Cisco ThousandEyes",
      "description": "Cisco ThousandEyes API v7 (tests, agents, network results)",
      "docs": "https://developer.cisco.com/docs/thousandeyes/",
      "categories": [
        "internet-measurement",
        "network"
      ],
      "maintainers": [
        "Kentrow"
      ],
      "tier": "official",
      "validation": {
        "status": "simulator",
        "notes": "Built from the rate limit documentation of API v7 and the official SDKs (thousandeyes-sdk-python 7.0.110, the paths and fields of their generated docs); not run against a real ThousandEyes account yet"
      },
      "origin": "builtin",
      "status": "active",
      "readme": "providers/cisco-thousandeyes/README.md",
      "simulator": true,
      "auth": "bearer",
      "templates": [
        {
          "name": "thousandeyes-agents",
          "path": "/agents",
          "defaultInterval": "15m",
          "metrics": [
            "thousandeyes_agent_info",
            "thousandeyes_agent_up"
          ]
        },
        {
          "name": "thousandeyes-network-results",
          "path": "/test-results/{testId}/network",
          "defaultInterval": "5m",
          "metrics": [
            "thousandeyes_network_health_score",
            "thousandeyes_network_jitter_seconds",
            "thousandeyes_network_latency_max_seconds",
            "thousandeyes_network_latency_min_seconds",
            "thousandeyes_network_latency_seconds",
            "thousandeyes_network_loss_ratio",
            "thousandeyes_network_results_truncated"
          ]
        },
        {
          "name": "thousandeyes-tests",
          "path": "/tests",
          "defaultInterval": "1h",
          "metrics": [
            "thousandeyes_test_enabled",
            "thousandeyes_test_info",
            "thousandeyes_test_interval_seconds"
          ]
        }
      ],
      "limits": [
        {
          "name": "organization",
          "kind": "quota",
          "value": "auto (240 until learned) per minute",
          "scope": [
            "account"
          ],
          "description": "240 requests a minute per organization, the minute starting at the first request of a batch; X-Organization-Rate-Limit-Limit, -Remaining and -Reset (the epoch of the next rollover) on every response, 429 when exceeded (developer.cisco.com/docs/thousandeyes/rate-limits). The documented example shows a limit of 20: the max is learned from the limit header. The reset header keeps the window on the one of the API (spec 04, Header sync).",
          "source": {
            "kind": "vendor-docs",
            "url": "https://developer.cisco.com/docs/thousandeyes/rate-limits/",
            "date": "2026-11"
          }
        }
      ]
    },
